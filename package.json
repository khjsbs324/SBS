{
    "name": "sbs-academy-static-site",
    "version": "1.0.0",
    "private": true,
    "scripts": {
        "build:styles": "sass ./assets/scss/main.scss ./assets/css/main.css --style=compressed --no-source-map",
        "build:styles:dev": "sass ./assets/scss/main.scss ./assets/css/main.css --style=expanded --no-source-map",
        "watch:styles": "sass ./assets/scss/main.scss ./assets/css/main.css --watch --style=expanded --no-source-map",
        "validate:data": "node ./scripts/validate-data.js",
        "validate:styles": "node ./scripts/validate-styles.js",
        "validate:portfolio-sync": "node ./scripts/validate-portfolio-sync.js",
        "validate:seminar-sync": "node ./scripts/validate-seminar-sync.js",
        "validate:books": "node ./scripts/validate-books.js",
        "validate:department": "node ./scripts/validate-department.js",
        "validate:exams": "node ./scripts/validate-exams.js",
        "validate": "npm run validate:data && npm run validate:styles && npm run validate:portfolio-sync && npm run validate:seminar-sync && npm run validate:books && npm run validate:department && npm run validate:exams"
    },
    "devDependencies": {
        "sass": "1.101.0"
    }
}
