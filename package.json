{
    "name": "sbs-academy-static-site",
    "version": "1.0.0",
    "private": true,
    "scripts": {
        "build:utilities": "tailwindcss -c ./tailwind.config.js -i ./assets/styles/framework.css -o ./assets/css/framework.css --minify",
        "build:custom": "sass ./assets/scss/main.scss ./assets/css/main.css --style=compressed --no-source-map",
        "build:styles": "npm run build:utilities && npm run build:custom",
        "generate:supabase-seed": "node ./scripts/generate-supabase-seed.js",
        "watch:utilities": "tailwindcss -c ./tailwind.config.js -i ./assets/styles/framework.css -o ./assets/css/framework.css --watch",
        "watch:custom": "sass ./assets/scss/main.scss ./assets/css/main.css --watch --style=expanded --no-source-map",
        "validate:data": "node ./scripts/validate-data.js",
        "validate:styles": "node ./scripts/validate-styles.js",
        "validate": "npm run validate:data && npm run validate:styles"
    },
    "devDependencies": {
        "sass": "1.101.0",
        "supabase": "2.109.1",
        "tailwindcss": "3.4.17"
    }
}
